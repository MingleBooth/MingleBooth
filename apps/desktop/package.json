{
  "name": "@minglebooth/desktop",
  "version": "1.0.0",
  "type": "module",
  "description": "MingleBooth Studio — Professional Operator Desktop Application",
  "author": "MingleBooth Team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs",
    "electron:build:mac": "tsc && vite build && electron-builder --mac",
    "electron:build:win": "tsc && vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.minglebooth.studio",
    "productName": "MingleBooth Studio",
    "copyright": "Copyright © 2026 MingleBooth Platform",
    "electronVersion": "44.1.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@minglebooth/camera": "*",
    "@minglebooth/event-core": "*",
    "@minglebooth/gif-engine": "*",
    "@minglebooth/license": "*",
    "@minglebooth/photo-engine": "*",
    "@minglebooth/shared": "*",
    "@minglebooth/sync-engine": "*",
    "@minglebooth/template-engine": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.439.0",
    "nanoid": "^5.0.7",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "44.1.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
