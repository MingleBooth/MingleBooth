{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@minglebooth/camera": ["../../packages/camera/src/index.ts"],
      "@minglebooth/sync-engine": ["../../packages/sync-engine/src/index.ts"],
      "@minglebooth/shared": ["../../packages/shared/src/index.ts"],
      "@minglebooth/license": ["../../packages/license/src/index.ts"],
      "@minglebooth/photo-engine": ["../../packages/photo-engine/src/index.ts"],
      "@minglebooth/gif-engine": ["../../packages/gif-engine/src/index.ts"],
      "@minglebooth/template-engine": ["../../packages/template-engine/src/index.ts"],
      "@minglebooth/event-core": ["../../packages/event-core/src/index.ts"]
    }
  },
  "include": ["src"]
}
