{
  "name": "minglebooth-monorepo",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "MINGLEBOOTH — Professional Photobooth Operating Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n \"web,desktop\" -c \"cyan,magenta\" \"npm --workspace=@minglebooth/web run dev\" \"npm --workspace=@minglebooth/desktop run dev\"",
    "dev:desktop": "npm --workspace=@minglebooth/desktop run dev",
    "dev:web": "npm --workspace=@minglebooth/web run dev",
    "dev:mobile": "npm --workspace=@minglebooth/mobile run dev",
    "desktop:electron": "npm --workspace=@minglebooth/desktop run electron:dev",
    "tether": "node apps/desktop/electron/tether-server.cjs",
    "desktop:build:mac": "npm --workspace=@minglebooth/desktop run electron:build:mac",
    "desktop:build:win": "npm --workspace=@minglebooth/desktop run electron:build:win",
    "mobile:build": "npm --workspace=@minglebooth/mobile run build",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "photobooth",
    "electron",
    "nextjs",
    "supabase",
    "roaming-booth"
  ],
  "author": "MingleBooth Team",
  "license": "UNLICENSED"
}
