# ==============================================================================
# MINGLEBOOTH ENVIRONMENT CONFIGURATION
# ==============================================================================

# Environment: development | staging | production
ENVIRONMENT=development

# Subscription Enforcement:
# - Set to 'false' during development/testing (Payment bypass & unrestricted test access)
# - Set to 'true' for production enforcement
SUBSCRIPTION_ENABLED=false

# Master Admin / Test Account (Zero hardcoding in code)
ADMIN_EMAIL=admin@minglebooth.com
ADMIN_PASSWORD=super-secret-admin-password-123

# Public Gallery & Web Domain Configuration
NEXT_PUBLIC_GALLERY_DOMAIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Payment Gateway (Lynk.id / LinkIn / Mock)
PAYMENT_PROVIDER=lynk
LYNK_MERCHANT_KEY=your-lynk-secret-key
NEXT_PUBLIC_LYNK_URL_STARTER=https://lynk.id/your_account/starter
NEXT_PUBLIC_LYNK_URL_PRO=https://lynk.id/your_account/pro
NEXT_PUBLIC_LYNK_URL_BUSINESS=https://lynk.id/your_account/business
